

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JERRIN | Bookstore & Electronics</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#fff;color:#222}
header{background:#c90024;color:white;padding:18px;text-align:center}
.logo{font-size:32px;font-weight:900;letter-spacing:2px}
nav{background:#a9001d;padding:13px;text-align:center}
nav a{color:white;text-decoration:none;margin:0 12px;font-weight:bold}
.hero{background:#fff0f2;padding:55px 20px;text-align:center}
.hero h1{color:#c90024;font-size:34px}
button{background:#c90024;color:white;border:0;padding:12px 20px;border-radius:5px;cursor:pointer}
.search{text-align:center;padding:20px}
input{padding:12px;width:90%;max-width:400px;border:1px solid #ccc;border-radius:5px}
.products{padding:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px}
.card{border:1px solid #eee;border-radius:10px;padding:15px;text-align:center;box-shadow:0 2px 8px #ddd}
.card .pic{font-size:65px;background:#fff0f2;padding:15px;border-radius:8px}
.card h3{font-size:17px}
.price{color:#c90024;font-weight:bold}
#cart{padding:25px;background:#fff0f2}
footer{background:#222;color:white;text-align:center;padding:25px}
</style>
</head>
<body>
<header>
<div class="logo">JERRIN</div>
BOOKSTORE & ELECTRONICS
</header>
<nav>
<a href="#home">Home</a>
<a href="#books">Books</a>
<a href="#electronics">Electronics</a>
<a href="#cart">Cart 🛒 <span id="count">0</span></a>
</nav>
<section class="hero" id="home">
<h1>Welcome to JERRIN</h1>
<h2>Everything You Need, in One Place.</h2>
<p>Discover books, electronics and amazing gadgets.</p>
<button onclick="document.getElementById('books').scrollIntoView()">Shop Now</button>
</section>
<div class="search">
<input id="search" placeholder="Search products..." oninput="filterProducts()">
</div>
<h2 id="books" style="text-align:center;color:#c90024">📚 Books Collection</h2>
<section class="products" id="bookList"></section>
<h2 id="electronics" style="text-align:center;color:#c90024">🎧 Electronics & Gadgets</h2>
<section class="products" id="electronicsList"></section>
<section id="cart">
<h2>🛒 Your Shopping Cart</h2>
<div id="cartItems">Your cart is empty.</div>
<h3>Total: ₹<span id="total">0</span></h3>
<button onclick="checkout()">Place Order on WhatsApp</button>
</section>
<footer>
<h2>JERRIN</h2>
<p>Bookstore & Electronics</p>
<p>Thane, Maharashtra, India</p>
<p>© 2026 JERRIN. All rights reserved.</p>
</footer>
<script>
const products=[
{name:"English Story Book",price:199,emoji:"📚",type:"book"},
{name:"Study Notebook",price:99,emoji:"📒",type:"book"},
{name:"Educational Book",price:249,emoji:"📖",type:"book"},
{name:"Headphones",price:599,emoji:"🎧",type:"electronics"},
{name:"Smart Watch",price:999,emoji:"⌚",type:"electronics"},
{name:"Bluetooth Speaker",price:799,emoji:"🔊",type:"electronics"},
{name:"Wireless Mouse",price:399,emoji:"🖱️",type:"electronics"},
{name:"Power Bank",price:899,emoji:"🔋",type:"electronics"}
];
let cart=[];
function render(){
["book","electronics"].forEach(type=>{
const target=document.getElementById(type==="book"?"bookList":"electronicsList");
target.innerHTML=products.filter(p=>p.type===type).map(p=>`
<div class="card">
<div class="pic">${p.emoji}</div>
<h3>${p.name}</h3>
<p class="price">₹${p.price}</p>
<button onclick="add('${p.name}')">Add to Cart</button>
</div>`).join("");
});
}
function add(name){
const p=products.find(x=>x.name===name);
cart.push(p);
updateCart();
}
function updateCart(){
document.getElementById("count").textContent=cart.length;
document.getElementById("total").textContent=cart.reduce((s,p)=>s+p.price,0);
document.getElementById("cartItems").innerHTML=cart.length?
cart.map((p,i)=>`${p.emoji} ${p.name} - ₹${p.price} <button onclick="removeItem(${i})">Remove</button>`).join("<br><br>"):
"Your cart is empty.";
}
function removeItem(i){cart.splice(i,1);updateCart();}
function filterProducts(){
const q=document.getElementById("search").value.toLowerCase();
document.querySelectorAll(".card").forEach(c=>{
c.style.display=c.textContent.toLowerCase().includes(q)?"block":"none";
});
}
function checkout(){
if(!cart.length){alert("Your cart is empty!");return;}
const number=prompt("Enter your JERRIN WhatsApp number with country code (digits only):");
if(!number)return;
const items=cart.map(p=>p.name+" - ₹"+p.price).join("\n");
const total=cart.reduce((s,p)=>s+p.price,0);
const message=encodeURIComponent("Hello JERRIN! I want to order:\n"+items+"\nTotal: ₹"+total);
window.open("https://wa.me/"+number+"?text="+message,"_blank");
}
render();
</script>
</body>
</html>
